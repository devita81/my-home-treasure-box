# Supabase — get values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Sentry (optional) — leave empty to skip error tracking entirely
# Get the DSN at: Sentry → Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# Sentry source map upload (build-time only, NEVER expose to client)
# Required only for production builds that should upload source maps.
# Create at: Sentry → Settings → Account → API → Personal Tokens
# Scopes needed: project:write, project:releases, org:read
SENTRY_AUTH_TOKEN=
